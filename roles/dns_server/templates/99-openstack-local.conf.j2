# Unbound 配置文件 - OpenStack 内部简单主机名解析
# 只解析 3 个域名 + 反向 PTR + 外部转发
# 2026-01-14 修正版

server:
    verbosity: 1
    interface: 0.0.0.0
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes

    # 允许查询的网络（根据你的实际环境调整）
    access-control: 10.0.0.0/8     allow
    access-control: 192.168.0.0/16 allow
    access-control: 172.16.0.0/12  allow

    # 性能优化，适合旧硬件
    num-threads: 1
    msg-cache-size: 4m
    rrset-cache-size: 4m
    prefetch: yes

    # 日志（可选，调试时可打开）
    logfile: "/var/log/unbound/unbound.log"
    log-queries: no

    # 关闭 chroot（简化常见问题）
    chroot: ""

# 正向解析：openstack.local. 域静态本地解析
local-zone: "openstack.local." static

#local-data: "controller.openstack.local.      IN A 10.1.10.200"
#local-data: "compute01.openstack.local.      IN A 10.1.10.201"
#local-data: "compute02.openstack.local.      IN A 10.1.10.202"

# 反向解析 PTR（正确语法：直接写正向 IP + 主机名，Unbound 自动反转）
local-zone: "10.1.10.in-addr.arpa." static
local-data-ptr: "10.1.10.200 controller.openstack.local."
local-data-ptr: "10.1.10.201 compute01.openstack.local."
local-data-ptr: "10.1.10.202 compute02.openstack.local."

# 外部所有查询转发到公共 DNS
forward-zone:
    name: "."
    forward-addr: 8.8.8.8
    forward-addr: 1.1.1.1
    forward-first: no
